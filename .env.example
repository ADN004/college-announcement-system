# ─────────────────────────────────────────────────────────────────────────────
#  College Announcement System — Docker Environment Variables
#
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  NEVER commit .env to git — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# MySQL root password (used internally by the MySQL container)
MYSQL_ROOT_PASSWORD=change_me_root

# Application database credentials
DB_HOST=db
DB_NAME=college_announcement
DB_USER=cas_user
DB_PASS=change_me_app
